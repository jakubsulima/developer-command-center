# Sekrety funkcji Edge — nigdy nie kopiuj ich do apps/web ani zmiennych VITE_*.
AI_GOAL_REVIEW_ENABLED=true
AI_INBOX_TRIAGE_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=REPLACE_ME
OPENAI_GOAL_REVIEW_MODEL=gpt-6-luna
OPENAI_INBOX_TRIAGE_MODEL=gpt-6-luna
# Dla innego modelu ustaw również ceny wejścia i wyjścia (USD za 1 mln tokenów):
# OPENAI_GOAL_REVIEW_INPUT_USD_PER_MTOK=0.10
# OPENAI_GOAL_REVIEW_OUTPUT_USD_PER_MTOK=0.50
# OPENAI_INBOX_TRIAGE_INPUT_USD_PER_MTOK=0.10
# OPENAI_INBOX_TRIAGE_OUTPUT_USD_PER_MTOK=0.50
AI_WORKSPACE_DAILY_BUDGET_USD=0.50
AI_PROJECT_MONTHLY_BUDGET_USD=5.00
# Powrót do NVIDIA: AI_PROVIDER=nvidia oraz NVIDIA_API_KEY, NVIDIA_MODEL,
# NVIDIA_BASE_URL, NVIDIA_AUTH_MODE i NVIDIA_STRUCTURED_MODE.
AI_TIMEOUT_MS=60000
AI_MAX_INPUT_CHARS=40000
AI_MAX_OUTPUT_TOKENS=6000
AI_REVIEW_DAILY_LIMIT=10
# Cache Przeglądu AI wybiera się w Ustawieniach Workspace (24/72/168 h).
# Ta wartość nadpisuje wersję promptu w kodzie; ustaw 5 podczas wdrożenia staging.
AI_PROMPT_VERSION=5
AI_REVIEW_RETENTION_DAYS=90
AI_RUN_RETENTION_DAYS=30
AI_INBOX_TRIAGE_DAILY_LIMIT=30
AI_INBOX_TRIAGE_CACHE_HOURS=24
AI_INBOX_TRIAGE_TIMEOUT_MS=25000
AI_INBOX_TRIAGE_MAX_OUTPUT_TOKENS=700
AI_INBOX_TRIAGE_PROMPT_VERSION=1
AI_INBOX_TRIAGE_RETENTION_DAYS=90
