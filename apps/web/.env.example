# Backend produkcyjny i deweloperski. Użyj "demo" tylko do świadomego
# uruchomienia wersji bez chmury.
VITE_DATA_BACKEND=supabase

# Supabase Dashboard -> Connect / Settings -> API Keys
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# W produkcji pozostaw false. Klucz publishable jest publiczny; secret i
# service_role nie mogą nigdy trafić do zmiennych VITE_*.
VITE_ENABLE_DEMO_MODE=false

# Tylko widoczność formularza. Prawdziwą blokadę rejestracji ustaw w Supabase
# Auth przez wyłączenie "Allow new users to sign up".
VITE_ENABLE_SIGNUP=false

# Opcjonalny monitoring produkcyjny. Adapter wysyła wyłącznie typ błędu,
# typ operacji, anonimowy etap pierwszego przepływu i czasy — nigdy treść.
# Wyłączone domyślnie; endpoint musi być HTTPS (HTTP jest dozwolone tylko w DEV).
VITE_ERROR_REPORTING_ENABLED=false
VITE_ERROR_REPORTING_URL=https://monitoring.example.com/command-center/client-errors
